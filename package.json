{
  "name": "freeform-moodboard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "check:boards": "node scripts/check-board-sizes.mjs",
    "validate:boards": "node scripts/validate-boards.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prebuild": "npm run check:boards && npm run validate:boards && npm run typecheck && npm test",
    "build": "vite build && node scripts/publish-canvases.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "0.18.0",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@types/node": "22.17.0",
    "@types/react": "19.1.9",
    "@types/react-dom": "19.1.7",
    "@vitejs/plugin-react": "5.0.2",
    "typescript": "5.9.2",
    "vite": "7.1.4",
    "vitest": "3.2.4"
  }
}
